# Copy to .env.local (never commit real keys):
#   cp .env.example .env.local
#
# Required — Supabase Dashboard → Project Settings → API
#   EXPO_PUBLIC_SUPABASE_URL      = Project URL  (https://<project-ref>.supabase.co)
#   EXPO_PUBLIC_SUPABASE_ANON_KEY = Project API keys → anon / public
#
# After setting env, apply in order (SQL Editor — see migrations/README.md):
#   1. migrations/20260910_phase_c_supabase_baseline.sql
#   2. migrations/20260911_phase_d_atomic_joins_and_storage.sql

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional — iTunes Store country for music/movie search (default BR)
EXPO_PUBLIC_ITUNES_COUNTRY=BR

# Optional — better movie posters / credits. TMDB Settings → API
# EXPO_PUBLIC_TMDB_API_KEY=
