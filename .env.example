# Arquivo de exemplo - renomeie para .env.local
# Configure suas credenciais do Supabase aqui

EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Busca de música/filme (iTunes Search API — sem chave)
# Código do país da iTunes Store (BR, US, PT, etc.)
EXPO_PUBLIC_ITUNES_COUNTRY=BR

# Opcional. Melhora a busca de filmes (pôsteres e ficha do TMDB).
# Crie uma chave de leitura em https://www.themoviedb.org/settings/api
# EXPO_PUBLIC_TMDB_API_KEY=
